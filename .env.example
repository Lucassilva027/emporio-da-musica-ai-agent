# ==============================================================================
# EMPÓRIO DA MÚSICA — AI CUSTOMER SERVICE AGENT
# Configuração de Provedor de LLM (100% Gratuitos Recomendados)
# ==============================================================================

# Opção 1 (Recomendada - 100% Gratuita e Ultra-Rápida): Groq Cloud
# Crie sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Opção 2 (100% Gratuita via Google AI Studio): Google Gemini
# Crie sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opção 3: OpenAI (Opcional, caso o avaliador prefira usar OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opção 4: Ollama Local (Opcional, 100% offline se o servidor Ollama estiver ativo)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Provedor preferencial: "auto" | "groq" | "gemini" | "openai" | "ollama" | "local"
# No modo "auto", o agente usa a primeira API key configurada acima e, caso nenhuma
# esteja definida, aciona automaticamente o Motor Híbrido Local (Zero-Config),
# garantindo funcionamento imediato com embeddings locais + ferramentas SQLite/RAG.
LLM_PROVIDER=auto

# Data de referência para simulação consistente de prazos de pedidos (YYYY-MM-DD)
# Os pedidos da base ocorrem até março de 2026; 2026-03-23 permite testar pedidos
# recém-entregues, em trânsito e pendentes de forma realista.
REFERENCE_DATE=2026-03-23
