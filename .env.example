# ==============================================================================
# EMPÓRIO DA MÚSICA — AI CUSTOMER SERVICE AGENT
# ==============================================================================
# NUNCA cole chaves reais neste arquivo (.env.example é público no GitHub).
# Use o arquivo .env (local, ignorado pelo Git) para as suas secrets.
#
# Recomendação: configure GROQ + GEMINI juntos.
# Se a Groq estourar o limite, o agente faz failover automático para o Gemini.

# ------------------------------------------------------------------------------
# 1) Groq (grátis) — https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 2) Google Gemini (grátis) — https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# auto | groq | gemini | local
# Em auto: prioriza Groq → Gemini; sem keys usa motor local.
LLM_PROVIDER=auto

# Data de referência para prazos de pedidos/trocas (YYYY-MM-DD)
REFERENCE_DATE=2026-03-23
